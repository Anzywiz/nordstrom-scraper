# Proxies: comma or newline separated, numbered (sticky) logins only
PROXY_LIST=http://user:pass@host:port,http://user:pass@host:port

# Start at this entry of PROXY_LIST (0-based) so a rerun does not begin on the same, possibly flagged, IP
# PROXY_START=0

# TWO different keys: the listing API (sbn/v2 browse) and the PDP API (pdp/product-display) use different nord-api-keys.
# Both are optional: the scripts take the keys from the page's own request when they mint a session.
NORD_API_KEY_LISTING=
NORD_API_KEY_PDP=

# (keep your existing AWS / upload variables below)
